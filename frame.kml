<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Sheerr Weather — Live Lightning (NL)</name>
    <NetworkLink>
      <name>GLM Lightning — last 30 min</name>
      <flyToView>0</flyToView>
      <Link>
        <!-- Public repo raw file. Updated on demand by the "Generate latest NL
             lightning KMZ" GitHub Action (Actions tab > Run workflow), not
             continuously. Swap for a Bunny pull-zone URL later if/when the
             always-on loop goes live (see README). -->
        <href>https://raw.githubusercontent.com/eddie810/NL-Lightning/claude/lightning-kmz-download-ilwarw/latest/nl_lightning_latest.kmz</href>
        <!-- raw.githubusercontent.com caches for a few minutes regardless, so
             re-fetching faster than this just wastes requests. -->
        <refreshMode>onInterval</refreshMode>
        <refreshInterval>300</refreshInterval>
        <!-- Cache-buster query param to help bypass the CDN cache. -->
        <httpQuery>t=[clock]</httpQuery>
      </Link>
    </NetworkLink>
  </Document>
</kml>
