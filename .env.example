# --- Rolling window / cadence ---
WINDOW_MINUTES=30
INTERVAL_SECONDS=45

# --- Local working dir (granule cache + built KMZ) ---
WORKDIR=./work

# --- Source bucket (noaa-goes19 = GOES-East 2025+; noaa-goes16 for older) ---
GLM_BUCKET=noaa-goes19

# --- Bunny Storage (upload target) ---
# Storage host is region-specific: storage.bunnycdn.com (DE default),
# ny.storage.bunnycdn.com, la.storage.bunnycdn.com, uk..., sg..., etc.
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_STORAGE_PASSWORD=your-storage-zone-password
BUNNY_REMOTE_PATH=lightning/glm_lightning_live.kmz

# --- Public pull-zone URL that serves the object above ---
BUNNY_PULL_URL=https://your-zone.b-cdn.net/lightning/glm_lightning_live.kmz

# --- Purge instead of short TTL? (leave false and set a short pull-zone TTL) ---
PURGE_ON_UPLOAD=false
BUNNY_ACCOUNT_API_KEY=
